@import 'pkg:@microsoft/sp-office-ui-fabric-core/dist/sass/SPFabricCore.scss';
.root { --accent:#b7c800; background:var(--root-bg); color:var(--text); padding:24px 38px 34px; box-sizing:border-box; width:100%; }
.header { margin-bottom:18px; h2 { margin:0; color:var(--text); font-size:28px; line-height:1.2; font-weight:700; } }
.carousel { position:relative; padding:0 28px 36px; }
.track { display:grid; grid-auto-flow:column; grid-auto-columns:minmax(calc(270px * var(--card-size)),calc(312px * var(--card-size))); gap:24px; overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; scrollbar-width:none; -ms-overflow-style:none; padding:2px; }
.track::-webkit-scrollbar { display:none; }
.card { scroll-snap-align:start; display:grid; grid-template-rows:calc(178px * var(--image-height)) minmax(calc(214px * var(--card-size)),1fr) 42px; min-height:434px; background:var(--card-bg); border:1px solid #3a3a3a; box-shadow:0 5px 18px rgba(0,0,0,.28); overflow:hidden; transition:transform .18s ease,border-color .18s ease; cursor:pointer; }
.card:hover { transform:translateY(-3px); border-color:#666; }.card:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.imageLink{position:relative;display:block;overflow:hidden;background:#353535;color:var(--text)}.image{width:100%;height:100%;object-fit:cover;display:block}.imageFallback{width:100%;height:100%;background:linear-gradient(135deg,#5d6411,#202020)}.imageShade{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.05) 30%,rgba(0,0,0,.75) 100%)}.dateBadge{position:absolute;left:16px;bottom:14px;display:flex;flex-direction:column;text-shadow:0 1px 3px #000}.dateBadge span{font-size:14px;font-weight:700}.dateBadge strong{font-size:31px;line-height:1.05}
.content{display:flex;flex-direction:column;padding:16px;background:var(--card-bg);color:var(--text)}.siteName{color:var(--secondary-text);font-size:12px;margin-bottom:6px}.category{font-size:13px;font-weight:700;margin-bottom:6px}.title{color:var(--text);font-size:17px;line-height:1.3;font-weight:700}.spacer{flex:1;min-height:28px}.meta{color:var(--text);font-size:14px;font-weight:600;margin-top:14px;white-space:nowrap;}.location{color:var(--secondary-text);font-size:14px;margin-top:8px}
.footer{border-top:1px solid #404040;background:var(--card-bg);display:flex;align-items:center;padding:0 12px}.calendarLink{border:0;background:transparent;color:var(--text);padding:5px;cursor:pointer;display:inline-flex}.calendarLink:hover,.calendarLink:focus-visible{color:var(--accent)}.calendarPlusIcon{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;display:block}
.arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:42px;height:42px;border-radius:50%;border:1px solid #777;background:#282828;color:#fff;font-size:27px;cursor:pointer}.arrow:disabled{opacity:.3;cursor:default}.arrow:hover:not(:disabled),.arrow:focus-visible{border-color:var(--accent);outline:2px solid var(--accent)}.arrowLeft{left:-22px}.arrowRight{right:-22px}
.dots{position:absolute;left:50%;bottom:2px;transform:translateX(-50%);display:flex;gap:18px;align-items:center}.dot,.dotActive{width:18px;height:18px;border-radius:50%;border:1.5px solid var(--text);background:transparent;padding:0;cursor:pointer}.dotActive{background:var(--text);box-shadow:inset 0 0 0 3px var(--root-bg)}
.status{padding:32px 0;color:var(--secondary-text)}.error{padding:16px;border-left:4px solid #d83b01;color:var(--text);background:#321b13;word-break:break-word}
@media(max-width:640px){.root{padding:20px 30px 24px}.track{grid-auto-columns:minmax(260px,88vw);gap:16px}.header h2{font-size:24px}.arrowLeft{left:-24px}.arrowRight{right:-24px}}
@media(prefers-reduced-motion:reduce){.card{transition:none}.track{scroll-behavior:auto}}
