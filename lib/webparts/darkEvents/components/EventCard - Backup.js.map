import * as React from 'react';
import { IEventItem } from '../models/IEventItem';
import styles from './DarkEvents.module.scss';

interface IEventCardProps {
  event: IEventItem;
  accentColor: string;
  fallbackImageUrl: string;
  showSiteName: boolean;
  showCategory: boolean;
  imageFocusX: number;
  imageFocusY: number;
}

const dateFormatter = new Intl.DateTimeFormat('de-CH', { weekday: 'short', day: '2-digit', month: 'short' });
const timeFormatter = new Intl.DateTimeFormat('de-CH', { hour: '2-digit', minute: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('de-CH', { month: 'short' });

const CalendarPlusIcon: React.FC = () => (
  <svg className={styles.calendarPlusIcon} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M7 2v3M17 2v3M3.5 8.5h17M5.5 4h13a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
    <path d="M12 11.5v6M9 14.5h6" />
  </svg>
);

const escapeIcs = (value: string): string => value
  .replace(/\\/g, '\\\\')
  .replace(/\r?\n/g, '\\n')
  .replace(/,/g, '\\,')
  .replace(/;/g, '\\;');

const htmlToText = (value: string): string => {
  const element = document.createElement('div');
  element.innerHTML = value || '';
  return element.textContent || element.innerText || '';
};

const toIcsDate = (value: Date): string => value.toISOString()
  .replace(/[-:]/g, '')
  .replace(/\.\d{3}Z$/, 'Z');

const safeFileName = (value: string): string => {
  const cleaned = value.replace(/[\\/:*?"<>|]/g, '-').trim();
  return `${cleaned || 'event'}.ics`;
};

const downloadIcs = (event: IEventItem): void => {

  const plainDescription =
    htmlToText(event.description).trim();

  const htmlDescription =
    event.description || '';

  const escapeHtmlForIcs = (value: string): string =>
    value
      .replace(/\\/g, '\\\\')
      .replace(/\r?\n/g, '')
      .replace(/,/g, '\\,')
      .replace(/;/g, '\\;');

  const lines = [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:-//Agrisano//Dark Events//DE',
    'CALSCALE:GREGORIAN',
    'METHOD:PUBLISH',
    'BEGIN:VEVENT',

    `UID:agrisano-${event.siteName}-${event.id}@sharepoint`,

    `DTSTAMP:${toIcsDate(new Date())}`,

    `DTSTART:${toIcsDate(event.start)}`,

    `DTEND:${toIcsDate(event.end)}`,

    `SUMMARY:${escapeIcs(event.title)}`,

    ...(event.category
      ? [`CATEGORIES:${escapeIcs(event.category)}`]
      : []),

    `LOCATION:${escapeIcs(event.location || '')}`,

    `DESCRIPTION:${escapeIcs(plainDescription)}`,

    `X-ALT-DESC;FMTTYPE=text/html:${escapeHtmlForIcs(
      htmlDescription
    )}`,

    'END:VEVENT',
    'END:VCALENDAR'
  ];

  const blob = new Blob(
    [lines.join('\r\n')],
    {
      type: 'text/calendar;charset=utf-8'
    }
  );

  const url =
    URL.createObjectURL(blob);

  const anchor =
    document.createElement('a');

  anchor.href = url;
  anchor.download =
    safeFileName(event.title);

  document.body.appendChild(anchor);

  anchor.click();

  anchor.remove();

  URL.revokeObjectURL(url);
};

const EventCard: React.FC<IEventCardProps> = ({
  event, accentColor, fallbackImageUrl, showSiteName, showCategory, imageFocusX, imageFocusY
}) => {
  const sameDay = event.start.toDateString() === event.end.toDateString();
  const image = event.imageUrl || fallbackImageUrl;
  const timeText = event.allDay ? 'Ganztägig' : sameDay
    ? `${dateFormatter.format(event.start)}, ${timeFormatter.format(event.start)}`
    : `${dateFormatter.format(event.start)} – ${dateFormatter.format(event.end)}`;
  const dayText = sameDay ? String(event.start.getDate()) : `${event.start.getDate()}–${event.end.getDate()}`;
  const openEvent = (): void => { window.location.href = event.eventUrl; };

  const onCardKeyDown = (keyboardEvent: React.KeyboardEvent<HTMLElement>): void => {
    if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
      keyboardEvent.preventDefault();
      openEvent();
    }
  };

  const onCalendarClick = (mouseEvent: React.MouseEvent<HTMLButtonElement>): void => {
    mouseEvent.stopPropagation();
    downloadIcs(event);
  };

  return (
    <article className={styles.card} role="link" tabIndex={0} aria-label={`${event.title} öffnen`} onClick={openEvent} onKeyDown={onCardKeyDown}>
      <div className={styles.imageLink}>
        {image ? <img className={styles.image} src={image} alt="" loading="lazy" style={{ objectPosition: `${imageFocusX}% ${imageFocusY}%` }} /> : <div className={styles.imageFallback} />}
        <div className={styles.imageShade} />
        <div className={styles.dateBadge}>
          <span>{monthFormatter.format(event.start).replace('.', '').toUpperCase()}</span>
          <strong>{dayText}</strong>
        </div>
      </div>
      <div className={styles.content}>
        {showCategory && event.category && <div className={styles.category} style={{ color: accentColor }}>{event.category}</div>}
        {showSiteName && event.siteName && <div className={styles.siteName}>{event.siteName}</div>}
        <div className={styles.title}>{event.title}</div>
        <div className={styles.spacer} />
        <div className={styles.meta}>{timeText}</div>
        {event.location && <div className={styles.location}>{event.location}</div>}
      </div>
      <div className={styles.footer}>
        <button type="button" className={styles.calendarLink} title="Als ICS herunterladen" aria-label={`${event.title} als ICS herunterladen`} onClick={onCalendarClick}>
          <CalendarPlusIcon />
        </button>
      </div>
    </article>
  );
};

export default EventCard;
