import * as React from 'react';
import { useEffect, useMemo, useRef, useState } from 'react';
import { IDarkEventsProps } from './IDarkEventsProps';
import { IEventItem } from '../models/IEventItem';
import { SharePointEventsService } from '../services/SharePointEventsService';
import EventCard from './EventCard';
import styles from './DarkEvents.module.scss';

const DarkEvents: React.FC<IDarkEventsProps> = props => {
  const [events, setEvents] = useState<IEventItem[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [activePage, setActivePage] = useState(0);
  const [pageCount, setPageCount] = useState(1);
  const trackRef = useRef<HTMLDivElement>(null);
  const service = useMemo(() => new SharePointEventsService(props.context), [props.context]);

  useEffect(() => {
    let active = true;
    setLoading(true);
    setError('');
    service.getEvents(props.sourceMode, props.selectedListId, props.selectedSites, props.numberOfEvents, props.showPastEvents)
      .then(items => { if (active) { setEvents(items); setLoading(false); } })
      .catch((reason: unknown) => {
        if (active) { setError(reason instanceof Error ? reason.message : 'Ereignisse konnten nicht geladen werden.'); setLoading(false); }
      });
    return () => { active = false; };
  }, [service, props.sourceMode, props.selectedListId, props.selectedSites, props.numberOfEvents, props.showPastEvents]);

  const updatePagination = (): void => {
    const track = trackRef.current;
    if (!track) return;
    const pages = Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth));
    setPageCount(pages);
    const page = Math.min(pages - 1, Math.round(track.scrollLeft / Math.max(1, track.clientWidth)));
    setActivePage(page);
  };

  useEffect(() => {
    const track = trackRef.current;
    if (!track) return;
    updatePagination();
    const onResize = (): void => updatePagination();
    window.addEventListener('resize', onResize);
    return () => window.removeEventListener('resize', onResize);
  }, [events]);

  const goToPage = (page: number): void => {
    const track = trackRef.current;
    if (!track) return;
    const nextPage = Math.max(0, Math.min(pageCount - 1, page));
    track.scrollTo({ left: nextPage * track.clientWidth, behavior: 'smooth' });
    setActivePage(nextPage);
  };

  return (
    <section className={styles.root} style={{
      ['--accent' as string]: props.accentColor,
      ['--root-bg' as string]: props.backgroundColor,
      ['--card-bg' as string]: props.cardBackgroundColor,
      ['--text' as string]: props.textColor,
      ['--secondary-text' as string]: props.secondaryTextColor,
      ['--card-size' as string]: `${Math.max(50, Math.min(200, Number(props.cardSizePercent) || 100)) / 100}`,
      ['--image-height' as string]: `${Math.max(50, Math.min(200, Number(props.imageHeightPercent) || 100)) / 100}`
    }}>
      <div className={styles.header}><h2>Events</h2></div>
      {loading && <div className={styles.status}>Ereignisse werden geladen …</div>}
      {!loading && error && <div className={styles.error}><strong>Fehler beim Laden</strong><br />{error}</div>}
      {!loading && !error && events.length === 0 && <div className={styles.status}>Keine passenden Ereignisse gefunden.</div>}
      {!loading && !error && events.length > 0 && (
        <div className={styles.carousel}>
          <button type="button" className={`${styles.arrow} ${styles.arrowLeft}`} onClick={() => goToPage(activePage - 1)} aria-label="Vorherige Ereignisse" disabled={activePage === 0}>‹</button>
          <div className={styles.track} ref={trackRef} onScroll={updatePagination}>
            {events.map(event => <EventCard key={`${event.siteName}-${event.id}`} event={event} accentColor={props.accentColor} fallbackImageUrl={props.fallbackImageUrl} showSiteName={props.showSiteName} showCategory={props.showCategory} imageFocusX={Math.max(0, Math.min(100, Number(props.imageFocusXPercent) || 50))} imageFocusY={Math.max(0, Math.min(100, Number(props.imageFocusYPercent) || 50))} />)}
          </div>
          <button type="button" className={`${styles.arrow} ${styles.arrowRight}`} onClick={() => goToPage(activePage + 1)} aria-label="Nächste Ereignisse" disabled={activePage >= pageCount - 1}>›</button>
          {pageCount > 1 && <div className={styles.dots} aria-label="Ereignisseiten">
            {Array.from({ length: pageCount }, (_unused, index) => (
              <button key={index} type="button" className={index === activePage ? styles.dotActive : styles.dot} onClick={() => goToPage(index)} aria-label={`Seite ${index + 1}`} aria-current={index === activePage ? 'true' : undefined} />
            ))}
          </div>}
        </div>
      )}
    </section>
  );
};
export default DarkEvents;
